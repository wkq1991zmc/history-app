{
  "chapter_id": "02_luoyang",
  "title": "第一站·洛阳",
  "entry_scene": "city_wall",
  "scenes": [
    {
      "scene_id": "city_wall",
      "type": "narration",
      "lines": [
        { "type": "narration", "text": "中平六年，八月。" },
        { "type": "narration", "text": "五年过去了。" },
        { "type": "narration", "text": "画面：一队流民远远地望着洛阳城墙。城墙比天还高，墙根下排着长长的队伍，像一串蚂蚁。" },
        { "type": "narration", "text": "主角和阿萤站在队尾。两个人都长高了，也都瘦了。阿萤腰里的柴刀换成了一柄真刀——刀鞘是旧的，刀是新的。主角背上的行囊里多了一沓纸，纸边都磨毛了。" }
      ],
      "next": "city_gate"
    },
    {
      "scene_id": "city_gate",
      "type": "narration",
      "lines": [
        { "type": "dialogue", "speaker": "阿萤", "stage_direction": "瞥着城门口的兵", "text": "……五年了，第一次看见这么高的墙。" },
        { "type": "dialogue", "speaker": "主角", "text": "你怕吗？" },
        { "type": "dialogue", "speaker": "阿萤", "text": "怕。" },
        { "type": "dialogue", "speaker": "主角", "text": "怕什么？" },
        { "type": "dialogue", "speaker": "阿萤", "stage_direction": "盯着城门", "text": "怕进去就出不来了。" },
        { "type": "narration", "text": "队伍慢慢往前挪。城门口的兵在搜身、在收钱。一个老头掏不出钱，被一脚踹翻，行李扔在路边，人哭着爬走了。轮到一个抱孩子的妇人，兵掂了掂她怀里的婴儿，笑着说了句什么，妇人脸色刷白，从袖子里摸出最后一只银镯子。" },
        { "type": "dialogue", "speaker": "阿萤", "stage_direction": "极轻", "text": "……这就是洛阳。" }
      ],
      "next": "gate_captain"
    },
    {
      "scene_id": "gate_captain",
      "type": "narration_with_choice",
      "lines": [
        { "type": "narration", "text": "轮到他们。一个满脸横肉的城门校尉拦住主角。" },
        { "type": "dialogue", "speaker": "校尉", "text": "哪里来的？" },
        { "type": "dialogue", "speaker": "主角", "text": "涿郡。" },
        { "type": "dialogue", "speaker": "校尉", "text": "涿郡到洛阳走五年？" },
        { "type": "dialogue", "speaker": "主角", "text": "……路上耽搁了。" },
        { "type": "dialogue", "speaker": "校尉", "stage_direction": "伸手", "text": "进城费，两人，六十钱。" }
      ],
      "choices": [
        { "id": "pay",        "text": "默默掏钱",                                     "next": "branch_pay",       "pending": true },
        { "id": "cite_law",   "text": "「军爷，按朝廷律，入京无费。」",               "next": "branch_cite_law",  "pending": true },
        { "id": "show_doc",   "text": "「我有邺城官府的旧文书。」",                   "next": "document_scene",   "requires": { "identity": "寒门士子" } }
      ]
    },
    {
      "scene_id": "document_scene",
      "type": "narration",
      "lines": [
        { "type": "narration", "text": "主角从怀里掏出一份卷得发黄的文书，递过去。校尉一愣，接过来翻了翻，眯起眼。" },
        { "type": "dialogue", "speaker": "校尉", "text": "……邺城？这文书五年前的。" },
        { "type": "dialogue", "speaker": "主角", "text": "人没了，文书还在。" },
        { "type": "narration", "text": "校尉抬眼打量他。这一眼看了很久。然后忽然笑了。" },
        { "type": "dialogue", "speaker": "校尉", "text": "……进去吧。少在城里乱说话。这洛阳，最近不太平。" },
        { "type": "narration", "text": "主角接回文书，拉着阿萤往城里走。走出十几步，阿萤忍不住回头。" },
        { "type": "dialogue", "speaker": "阿萤", "text": "他怎么忽然就放我们了？" },
        { "type": "dialogue", "speaker": "主角", "stage_direction": "声音压得很低", "text": "因为他认得这份文书上的人。" },
        { "type": "dialogue", "speaker": "阿萤", "text": "……谁？" },
        { "type": "dialogue", "speaker": "主角", "text": "邺城太守。他死了五年了。可这文书上盖的印，还能用——说明朝廷的账，根本就没清过。这洛阳，比我们想的还乱。" }
      ],
      "next": "tongtuo_street"
    },
    {
      "scene_id": "tongtuo_street",
      "type": "narration",
      "lines": [
        { "type": "narration", "text": "洛阳的主干道，铜驼街。两侧店铺鳞次栉比，绸缎庄、银楼、酒肆、香料铺。一辆辆马车从中间走过，车帘掀起一角，露出里面绫罗的影子。" },
        { "type": "narration", "text": "阿萤看花了眼，嘴半张着，连路都不会走了。主角拉着她贴边走，眼睛却一直在看那些马车。" },
        { "type": "dialogue", "speaker": "阿萤", "stage_direction": "小声", "text": "……他们……他们怎么有这么多东西吃。" },
        { "type": "dialogue", "speaker": "主角", "text": "……他们一直都有。" }
      ],
      "next": "dongzhuo_carriage"
    },
    {
      "scene_id": "dongzhuo_carriage",
      "type": "historical_distant_view",
      "lines": [
        { "type": "narration", "text": "转过一个路口，前方忽然喧哗起来。一群百姓被官兵驱赶着退到街边，让出中间一条道。" },
        { "type": "dialogue", "speaker": "路人甲", "text": "来了来了，让让！" },
        { "type": "dialogue", "speaker": "路人乙", "stage_direction": "压低声", "text": "谁？" },
        { "type": "dialogue", "speaker": "路人甲", "text": "还能有谁。董司空。" },
        { "type": "narration", "text": "马蹄声由远及近。" },
        { "type": "narration", "text": "一队铁甲骑兵开道，跟在后面的是一辆极宽的青幰车，车轮碾过石板路，声音沉得像鼓。车帘掀着半边——这是故意的，让所有人看清楚里面坐的是谁。" },
        { "type": "narration", "text": "一个肥大的身影歪在车里。脸盘极阔，胡须油亮，眼睛半阖着，懒洋洋地朝街两边扫。所过之处，百姓全部跪下，头不敢抬。" },
        { "type": "dialogue", "speaker": "阿萤", "stage_direction": "被主角按着肩膀跪下，从指缝里偷看", "text": "……他就是……" },
        { "type": "dialogue", "speaker": "主角", "stage_direction": "声音几不可闻", "text": "嗯。董卓。" },
        { "type": "narration", "text": "车队走过他们面前的时候，董卓的目光似乎在他们这里停了一瞬——也许只是错觉。然后车继续往前走，朝皇宫方向去了。" },
        { "type": "narration", "text": "主角扶着阿萤起身。他发现自己手心全是汗。" },
        { "type": "dialogue", "speaker": "阿萤", "text": "……他一个眼神，就让一整条街跪下了。" },
        { "type": "dialogue", "speaker": "主角", "text": "……不是他厉害。是别人怕他。" },
        { "type": "dialogue", "speaker": "阿萤", "text": "有什么不一样？" },
        { "type": "dialogue", "speaker": "主角", "text": "怕他的人多了，他才厉害。怕他的人少了，他就什么都不是。" },
        { "type": "narration", "text": "这句话刚说完，主角自己愣了一下——这是五年前的他说不出来的话。" }
      ],
      "historical_figure": {
        "name": "董卓",
        "view_type": "distant"
      },
      "next": "inn_night"
    },
    {
      "scene_id": "inn_night",
      "type": "narration",
      "lines": [
        { "type": "narration", "text": "入夜。两人找了家最便宜的客栈住下。木楼，地板一踩就响。阿萤把刀放在枕头底下才肯睡。" },
        { "type": "narration", "text": "主角坐在窗边，借着一豆灯火翻看那份邺城文书。文书里夹着一张更旧的纸，是这五年里他自己写的——上面记着一路上听来的事：哪个郡守贪了多少，哪个县令杀了多少流民，哪一年闹蝗，哪一年闹瘟。密密麻麻，几乎没有空白。" },
        { "type": "narration", "text": "阿萤翻了个身。" },
        { "type": "dialogue", "speaker": "阿萤", "stage_direction": "迷迷糊糊", "text": "……你又在写？" },
        { "type": "dialogue", "speaker": "主角", "text": "嗯。" },
        { "type": "dialogue", "speaker": "阿萤", "text": "写这些有什么用。" },
        { "type": "dialogue", "speaker": "主角", "text": "……我也不知道。" },
        { "type": "dialogue", "speaker": "阿萤", "text": "……傻子。" },
        { "type": "narration", "text": "她又睡着了。" },
        { "type": "narration", "text": "主角看着她睡熟的侧脸——五年了，这张脸他每天都看，但每次看都觉得陌生。他不知道阿萤心里到底装着什么。他只知道，那个捂死弟弟的秘密，她从来没说过。他也从来没问过。" },
        { "type": "narration", "text": "他低头继续写。今天的一页只写了一句话——" },
        { "type": "narration", "display_style": "fullscreen_subtitle", "text": "「中平六年八月初九，董卓入洛。百姓跪满铜驼街。」" }
      ],
      "next": "ayinghuo_midnight_talk"
    },
    {
      "scene_id": "ayinghuo_midnight_talk",
      "type": "companion_free_talk",
      "lines": [
        { "type": "narration", "text": "半夜，阿萤忽然坐起来。主角已经吹了灯，屋里只有窗外的月光。" },
        { "type": "dialogue", "speaker": "阿萤", "text": "……睡不着。" }
      ],
      "companion_state_card": {
        "character": "阿萤",
        "time": "中平六年八月初九，深夜",
        "place": "洛阳廉价客栈",
        "recent_event": "第一次进大城市，白天看见董卓车驾的场面对她冲击极大",
        "current_emotion": "复杂、震撼、想吐露但不知如何说",
        "knows": [
          "今日在铜驼街看见董卓",
          "奶奶弟弟死亡已五年",
          "董卓让一整条街跪下"
        ],
        "wont_say": [
          "弟弟是她亲手闷死的（秘密一，锁定第三站徐州才能揭开）",
          "她其实在白天瞥见董卓的瞬间，第一反应不是恨，是\"原来这种人长这样\"——她对自己的这个反应感到害怕（秘密二的钩子，锁定第五站河北才能揭开）"
        ],
        "current_hints_allowed": [
          "我最近三个月开始失眠"
        ],
        "rounds_limit": null,
        "secrets_unlockable": [],
        "exit_conditions": [
          "玩家点击\"继续\"推进剧情"
        ]
      },
      "next": "knock_at_door"
    },
    {
      "scene_id": "knock_at_door",
      "type": "narration",
      "lines": [
        { "type": "narration", "text": "天还没亮，客栈被砸门声惊醒。" },
        { "type": "narration", "text": "主角猛地坐起。阿萤已经握住了刀。" },
        { "type": "dialogue", "speaker": "店小二", "stage_direction": "隔着门，声音发颤", "text": "客……客官！下面……下面有人找您！" },
        { "type": "dialogue", "speaker": "主角", "text": "找我？" },
        { "type": "dialogue", "speaker": "店小二", "text": "他……他说他叫……他不肯说名字，他说您看见他就知道了！" },
        { "type": "narration", "text": "主角和阿萤对视一眼。阿萤把刀抽出半截，主角按住她的手，摇头。" },
        { "type": "dialogue", "speaker": "主角", "stage_direction": "低声", "text": "你在屋里。" },
        { "type": "dialogue", "speaker": "阿萤", "text": "……不行。" },
        { "type": "dialogue", "speaker": "主角", "text": "阿萤。" },
        { "type": "dialogue", "speaker": "阿萤", "stage_direction": "咬着牙", "text": "……五分钟。五分钟你不回来，我下去。" },
        { "type": "narration", "text": "主角下楼。" }
      ],
      "next": "xunyu_appears"
    },
    {
      "scene_id": "xunyu_appears",
      "type": "narration",
      "lines": [
        { "type": "narration", "text": "客栈大堂里，灯还没灭。一个穿着青色文士袍的中年男人背对着他，正在看墙上挂的字画。听见脚步声，那人转过身——" },
        { "type": "narration", "text": "面容清癯，三缕长须，眼神温和却极有分量。" },
        { "type": "dialogue", "speaker": "男人", "stage_direction": "微笑", "text": "……五年前邺城的那份文书，是不是在你手上？" },
        { "type": "narration", "text": "主角浑身的血一下子凉了。" },
        { "type": "dialogue", "speaker": "主角", "text": "……您是？" },
        { "type": "dialogue", "speaker": "男人", "stage_direction": "拱手", "text": "在下颍川荀彧。" }
      ],
      "next": "xunyu_limited_talk"
    },
    {
      "scene_id": "xunyu_limited_talk",
      "type": "historical_limited_talk",
      "lines": [],
      "historical_figure": {
        "name": "荀彧",
        "view_type": "limited_talk",
        "knowledge_card": {
