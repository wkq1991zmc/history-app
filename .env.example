# ===== 大模型 API Key 配置 =====
# 请复制此文件为 .env 并填入你的真实 API Key

# 阿里百炼 API Key（小程序端使用，默认 qwen3.6-plus）
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 网页端模型配置；如果也走阿里百炼兼容接口，可以复用 DASHSCOPE_API_KEY
WEB_API_KEY=sk-your-web-model-key-here
WEB_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 小程序端模型（可改为其他百炼支持的模型）
# MINIPROGRAM_MODEL=qwen3.6-plus

# 网页端模型
# WEB_MODEL=qwen3.6-plus

# ===== 私密统计后台 =====
# 设置后访问 /admin，输入这个密码查看访问和互动统计
ADMIN_ANALYTICS_KEY=change-this-admin-password

# 可选：设置后网站反馈弹窗会显示公开联系邮箱
# PUBLIC_CONTACT_EMAIL=you@example.com

# ===== 微信小程序配置 =====
WX_APP_ID=your-wx-app-id
WX_APP_SECRET=your-wx-app-secret

# 开发模式（跳过微信登录验证，使用模拟 OpenID）
DEV_MODE=true
