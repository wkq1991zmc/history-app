page {
  background-color: #f5e6d3;
  color: #5a3e1b;
  font-family: "Noto Serif SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 0;
}

.card {
  background-color: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(139, 90, 43, 0.15);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.title {
  color: #5a3e1b;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  color: #8b6f47;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #8b6f47, transparent);
  margin: 20rpx 0;
}

.btn-primary {
  background: linear-gradient(135deg, #8b6f47 0%, #6b5a42 100%);
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: transparent;
  color: #8b6f47;
  border: 2rpx solid #8b6f47;
  border-radius: 40rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  text-align: center;
}

.btn-secondary::after {
  border: none;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  color: #8b6f47;
}

.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  color: #8b6f47;
  font-size: 28rpx;
}
