/* 容器 */
.container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

/* ===== 背景层 ===== */
.background-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.background-image {
  width: 100%;
  height: 100%;
  display: block;
}

.background-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to bottom,
    rgba(245, 235, 220, 0) 0%,
    rgba(245, 235, 220, 0) 15%,
    rgba(245, 235, 220, 0.6) 35%,
    rgba(245, 235, 220, 0.85) 55%,
    rgba(245, 235, 220, 0.95) 75%,
    #f5efe6 100%
  );
}

/* ===== 内容层 ===== */
.content-layer {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  padding-top: 500rpx;
}

/* ===== 朝代长河 ===== */
.dynasty-section {
  margin: 0 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.15);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5a3e1b;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.5);
}

.section-more {
  font-size: 24rpx;
  color: #8b6f47;
}

.dynasty-scroll {
  white-space: nowrap;
}

.dynasty-list {
  display: inline-flex;
  gap: 16rpx;
}

.dynasty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border: 1rpx solid rgba(139, 90, 43, 0.1);
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

.dynasty-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255, 255, 255, 0.1) 50%,
    transparent 70%
  );
  animation: shimmer 3s infinite;
}

.dynasty-card.active {
  background: rgba(139, 90, 43, 0.2);
  border-color: #8b6f47;
  box-shadow: 0 4rpx 16rpx rgba(139, 90, 43, 0.2);
}

.dynasty-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.dynasty-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #5a3e1b;
  margin-bottom: 4rpx;
  position: relative;
  z-index: 1;
}

.dynasty-year {
  font-size: 20rpx;
  color: #8b6f47;
  position: relative;
  z-index: 1;
}

/* ===== 大事件时间轴 ===== */
.events-section {
  margin: 0 24rpx 40rpx;
}

.events-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.event-card {
  display: flex;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(139, 90, 43, 0.12);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
  position: relative;
}

.event-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.15),
    transparent
  );
  animation: scanline 4s infinite;
}

.event-image {
  width: 200rpx;
  min-height: 180rpx;
  background: linear-gradient(135deg, rgba(232, 213, 183, 0.6) 0%, rgba(212, 196, 168, 0.6) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.event-image-text {
  font-size: 64rpx;
}

.event-image-real {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.event-info {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.event-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.event-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5a3e1b;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.5);
}

.event-dynasty-tag {
  font-size: 20rpx;
  color: #8b6f47;
  background: rgba(139, 90, 43, 0.12);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.event-desc {
  font-size: 24rpx;
  color: #6b5a42;
  line-height: 1.6;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.event-year {
  font-size: 22rpx;
  color: #8b6f47;
}

/* ===== 动画效果 ===== */
@keyframes shimmer {
  0% {
    transform: translateX(-100%) rotate(45deg);
  }
  100% {
    transform: translateX(100%) rotate(45deg);
  }
}

@keyframes scanline {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}
